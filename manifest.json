{
  "manifest_version": 3,
  "name": "Brain-Rot Rescue",
  "description": "Replaces distracting sites with your Chrome Reading List and offers intentional override controls.",
  "version": "0.1.0",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "readingList",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Brain-Rot Rescue",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/overlay.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "focus/focus.html",
        "focus/focus.js",
        "focus/focus.css",
        "content/overlay.css",
        "shared/hold-to-override.js",
        "dashboard/dashboard.html",
        "dashboard/dashboard.js",
        "dashboard/dashboard.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "dashboard/dashboard.html"
  }
}
